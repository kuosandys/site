---
import ExperimentLayout from "../../../layouts/ExperimentLayout.astro";

const prompts: Record<string, string> = {
  "01": "One color, one shape",
  "02": "12 principles of animation",
};

export async function getStaticPaths() {
  const modules = import.meta.glob("../../../modules/genuary2026/*.ts");
  return Object.keys(modules).map((path) => {
    const day = path.split("/").pop()?.replace(".ts", "");
    return { params: { day } };
  });
}

const { day } = Astro.params;
const prompt = prompts[day ?? ""];
---

<ExperimentLayout experiment={`${day} | Genuary 2026`}>
  <div id="sketch-container" class="sketch-wrapper" data-day={day}></div>
  {prompt && <p class="prompt">"{prompt}"</p>}
</ExperimentLayout>

<script>
  import p5 from "p5";

  let p5Instance: p5 | null = null;
  let currentSketch: Record<string, any> | null = null;
  let container: HTMLElement | null = null;

  function calculateCanvasSize(): number {
    if (!container) return 0;
    const parent = container.parentElement;
    const containerWidth =
      parent?.clientWidth || container.clientWidth || window.innerWidth;
    const maxSize = Math.min(containerWidth, 800);
    return maxSize;
  }

  async function loadSketch(dayId: string) {
    if (!p5Instance) return;

    if (currentSketch?.cleanup) {
      currentSketch.cleanup(p5Instance);
    }

    let module: Record<string, any>;
    try {
      module = await import(`../../../modules/genuary2026/${dayId}.ts`);
    } catch (error) {
      console.error(`Failed to load sketch for day ${dayId}:`, error);
      return;
    }

    currentSketch = module;

    for (const [key, value] of Object.entries(module)) {
      if (key === "default" || typeof value !== "function") continue;

      if (key === "setup") {
        value(p5Instance);
      } else {
        (p5Instance as any)[key] = () => value(p5Instance);
      }
    }
  }

  function initializeSketch() {
    container = document.getElementById("sketch-container");
    if (!container) return;

    const dayId = container.dataset.day;
    if (!dayId) return;

    const size = calculateCanvasSize();
    p5Instance = new p5((sketch: p5) => {
      p5Instance = sketch;

      sketch.setup = () => {
        const canvas = sketch.createCanvas(size, size);
        canvas.parent("sketch-container");

        loadSketch(dayId);
      };

      sketch.windowResized = () => {
        const newSize = calculateCanvasSize();
        sketch.resizeCanvas(newSize, newSize);
      };
    }, container);

    let resizeTimeout: number;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(() => {
        if (p5Instance) {
          const newSize = calculateCanvasSize();
          p5Instance.resizeCanvas(newSize, newSize);
        }
      }, 250);
    });
  }

  initializeSketch();
</script>

<style>
  .sketch-wrapper {
    display: flex;
    justify-content: center;
    align-items: start;
    width: 100%;
    height: auto;
  }

  .prompt {
    text-align: center;
    font-style: italic;
  }
</style>
